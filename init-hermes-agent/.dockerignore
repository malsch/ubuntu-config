# .dockerignore — keeps the Docker build CONTEXT small and prevents copying
# version-control data or secrets into images.
#
# Place this at the build-context root (usually the project root) and commit it.

# Version control
.git
.gitignore
.dockerignore

# Secrets / environment
.env
.env.*

# Dependencies & build output (these are reinstalled/rebuilt inside the image)
node_modules
__pycache__/
*.pyc
dist
build

# Logs and OS / editor noise
*.log
.DS_Store
.idea
.vscode